rules_version = '2';

// GameSouq (جيم سوق) — Firestore Security Rules
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMainAdmin() {
      return isSignedIn() && request.auth.token.email == "anwarbah69@gmail.com";
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdminRole() {
      return isSignedIn() && myUserDoc().role == "admin";
    }

    // ---------------- users ----------------
    match /users/{uid} {
      allow read: if true; // public profiles (names, ratings, badges)
      allow create: if isSignedIn() && request.auth.uid == uid;
      // users can update their own doc but never grant themselves a role;
      // only the main admin (or an admin-role account) can change `role`.
      allow update: if isSignedIn() && (
        (request.auth.uid == uid &&
          request.resource.data.role == resource.data.role) ||
        isMainAdmin() || isAdminRole()
      );
      allow delete: if false;
    }

    // ---------------- categories ----------------
    match /categories/{catId} {
      allow read: if true;
      allow write: if isMainAdmin() || isAdminRole();
    }

    // ---------------- offers ----------------
    match /offers/{offerId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.posterId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.posterId == request.auth.uid || isMainAdmin() || isAdminRole());
    }

    // ---------------- chats ----------------
    match /chats/{chatId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants;
      // participants can update status / request a middleman;
      // joining as middleman is allowed for any signed-in "middleman" role user
      // when the slot is empty.
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        (resource.data.middlemanId == null && myUserDoc().role == "middleman")
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---------------- ratings ----------------
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.raterId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
