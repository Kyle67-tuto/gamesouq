rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'anwarbah96@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isMM() {
      return signedIn() && exists(/databases/$(database)/documents/middlemen/$(request.auth.uid));
    }
    function isBanned() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned == true;
    }
    function chat(id)     { return get(/databases/$(database)/documents/chats/$(id)).data; }
    function offerDoc(id) { return get(/databases/$(database)/documents/offers/$(id)).data; }
    function changed()    { return request.resource.data.diff(resource.data).affectedKeys(); }

    /* ---------- users: own profile only; admin can look users up by e-mail.
                  Only the admin may set/clear the 'banned' field. ---------- */
    match /users/{uid} {
      allow read:  if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && (!('banned' in request.resource.data) || request.resource.data.banned == false);
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && !changed().hasAny(['banned']));
    }

    /* ---------- middlemen: public read (badges), admin writes.
                  A user invited by e-mail may create ONLY their own record. ---------- */
    match /middlemen/{uid} {
      allow read: if true;
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.admin == false
            && request.auth.token.email_verified == true
            && !isBanned()
            && exists(/databases/$(database)/documents/mmInvites/$(request.auth.token.email.lower())));
      allow update, delete: if isAdmin();
    }

    /* ---------- invitations (promotion by e-mail before the user signed in) ---------- */
    match /mmInvites/{email} {
      allow read, delete: if isAdmin() || (signedIn() && request.auth.token.email.lower() == email);
      allow create, update: if isAdmin();
    }

    /* ---------- categories ---------- */
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---------- offers ---------- */
    match /offers/{id} {
      allow read: if true;
      allow create: if signedIn() && !isBanned() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    /* ---------- offerImages: fallback storage for photos when ImgBB is unreachable ---------- */
    match /offerImages/{id} {
      allow read: if true;
      allow create: if signedIn() && !isBanned() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.images.size() <= 4;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    /* ---------- chats (deal rooms) ----------
       Admin has NO read access here: chats are visible to the two traders and the joined middleman only. */
    match /chats/{chatId} {

      allow read: if signedIn() && (
           request.auth.uid in resource.data.participants
        || resource.data.middlemanId == request.auth.uid
        || (isMM() && resource.data.mmRequested == true && resource.data.middlemanId == null)   // middleman queue
      );

      allow create: if signedIn() && !isBanned()
        && request.resource.data.keys().hasOnly(['offerId','offerTitle','offerType','offerImage',
              'ownerId','ownerName','ownerPhoto','starterId','starterName','starterPhoto',
              'participants','middlemanId','middlemanName','mmRequested','status','confirmedBy',
              'lastMessage','createdAt','updatedAt'])
        && chatId == request.resource.data.offerId + '_' + request.auth.uid
        && request.resource.data.starterId == request.auth.uid
        && request.resource.data.ownerId != request.auth.uid
        && request.resource.data.participants == [request.resource.data.ownerId, request.auth.uid]
        && offerDoc(request.resource.data.offerId).uid == request.resource.data.ownerId
        && request.resource.data.middlemanId == null
        && request.resource.data.mmRequested == false
        && request.resource.data.status == 'open'
        && request.resource.data.confirmedBy.size() == 0;

      allow update: if signedIn() && resource.data.status == 'open' && (
        // a) last-message preview (public messages only)
        ((request.auth.uid in resource.data.participants || request.auth.uid == resource.data.middlemanId)
          && changed().hasOnly(['lastMessage','updatedAt']))
        // b) a trader requests a middleman
        || (!isBanned() && request.auth.uid in resource.data.participants
          && resource.data.middlemanId == null && resource.data.mmRequested == false
          && changed().hasOnly(['mmRequested','updatedAt'])
          && request.resource.data.mmRequested == true)
        // c) an authorised middleman joins (only once, never as a trader)
        || (!isBanned() && isMM() && !(request.auth.uid in resource.data.participants)
          && resource.data.mmRequested == true && resource.data.middlemanId == null
          && changed().hasOnly(['middlemanId','middlemanName','updatedAt'])
          && request.resource.data.middlemanId == request.auth.uid)
        // d) direct deal (no middleman): each trader confirms; completed when both did
        || (request.auth.uid in resource.data.participants && resource.data.middlemanId == null
          && changed().hasOnly(['confirmedBy','status','completedAt','updatedAt'])
          && request.resource.data.confirmedBy.hasOnly(resource.data.participants)
          && request.resource.data.confirmedBy.hasAll(resource.data.confirmedBy)
          && request.auth.uid in request.resource.data.confirmedBy
          && ((request.resource.data.status == 'completed') == (request.resource.data.confirmedBy.size() == 2)))
        // e) the joined middleman completes the deal
        || (resource.data.middlemanId == request.auth.uid
          && changed().hasOnly(['status','completedAt','updatedAt'])
          && request.resource.data.status == 'completed')
        // f) cancel
        || ((request.auth.uid in resource.data.participants || request.auth.uid == resource.data.middlemanId)
          && changed().hasOnly(['status','updatedAt'])
          && request.resource.data.status == 'cancelled')
      );
      allow delete: if false;

      /* ---------- messages ----------
         public : audience = []                → both traders + joined middleman
         private: audience = [sender, recipient] → ONLY those two (the other trader can never read it) */
      match /messages/{mid} {

        allow read: if signedIn() && (
             (resource.data.type == 'public'
               && (request.auth.uid in chat(chatId).participants || chat(chatId).middlemanId == request.auth.uid))
          || request.auth.uid in resource.data.audience
        );

        allow create: if signedIn() && !isBanned()
          && chat(chatId).status == 'open'
          && request.resource.data.keys().hasOnly(['senderId','senderName','type','audience','text','createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && (
            // public message
            (request.resource.data.type == 'public' && request.resource.data.audience.size() == 0
              && (request.auth.uid in chat(chatId).participants || chat(chatId).middlemanId == request.auth.uid))
            // private: trader → middleman
            || (request.resource.data.type == 'private'
              && chat(chatId).middlemanId != null
              && request.auth.uid in chat(chatId).participants
              && request.resource.data.audience == [request.auth.uid, chat(chatId).middlemanId])
            // private: middleman → one trader
            || (request.resource.data.type == 'private'
              && chat(chatId).middlemanId == request.auth.uid
              && request.resource.data.audience.size() == 2
              && request.resource.data.audience[0] == request.auth.uid
              && request.resource.data.audience[1] in chat(chatId).participants)
          );

        allow update, delete: if false;
      }
    }

    /* ---------- reviews ----------
       id = kind_chatId_reviewerId → one review per person per deal, never editable.
       middleman: chat completed WITH a middleman, reviewer is a trader, target is that middleman.
       trade    : chat completed WITHOUT a middleman, traders review each other. */
    match /reviews/{rid} {
      allow read: if true;

      allow create: if signedIn() && !isBanned()
        && request.resource.data.keys().hasOnly(['kind','refId','refTitle','reviewerId','reviewerName',
              'reviewerPhoto','targetId','targetName','rating','comment','createdAt'])
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.targetId != request.auth.uid
        && rid == request.resource.data.kind + '_' + request.resource.data.refId + '_' + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 300
        && request.resource.data.createdAt == request.time
        && chat(request.resource.data.refId).status == 'completed'
        && request.auth.uid in chat(request.resource.data.refId).participants
        && (
          (request.resource.data.kind == 'middleman'
            && chat(request.resource.data.refId).middlemanId != null
            && chat(request.resource.data.refId).middlemanId == request.resource.data.targetId)
          ||
          (request.resource.data.kind == 'trade'
            && chat(request.resource.data.refId).middlemanId == null
            && request.resource.data.targetId in chat(request.resource.data.refId).participants)
        );

      allow update: if false;
      allow delete: if signedIn() && (resource.data.reviewerId == request.auth.uid || isAdmin());
    }
  }
}
