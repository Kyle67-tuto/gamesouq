rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ ضع نفس بريد المدير المكتوب في ADMIN_EMAIL داخل index.html
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'YOUR_EMAIL@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function signedIn() { return request.auth != null; }
    function isMM() {
      return signedIn() && exists(/databases/$(database)/documents/middlemen/$(request.auth.uid));
    }

    // بيانات المستخدمين: المستخدم يقرأ/يكتب ملفه فقط، والمدير يقرأ الجميع
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // الوسطاء: قراءة عامة (لعرض الشارات) والكتابة للمدير فقط
    match /middlemen/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // العروض
    match /offers/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // طلبات الوساطة
    match /middlemanRequests/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin() || isMM());
      allow update: if isAdmin() || isMM();
      allow delete: if isAdmin();
    }
  }
}
